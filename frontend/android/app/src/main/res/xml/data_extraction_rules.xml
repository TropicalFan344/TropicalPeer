<?xml version="1.0" encoding="utf-8"?>
<!--
  Nothing of TropicalPeer goes into cloud backups or phone-to-phone
  transfers: the profile holds this device's private identity key, and a
  restored copy would be a second device with the same identity (the two
  keep taking each other's place on the server). A new phone pairs anew.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
